Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    # 每格 5 cm，便于比较边长 2.5 cm 的方块。
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Plane: XY
      Cell Size: 0.05
      Plane Cell Count: 16
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Marker
      Name: Block Marker
      Enabled: true
      Value: true
      Topic:
        Value: /jixiebi/learning/block_marker
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Enabled: true
  Global Options:
    Background Color: 42; 42; 42
    # 与消息的 header.frame_id 相同，方块直接画在本课坐标系里。
    Fixed Frame: lesson09_world
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.18
      Focal Point:
        X: 0.20
        Y: 0
        Z: 0.0125
      Near Clip Distance: 0.001
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
Window Geometry:
  Height: 680
  Width: 900
