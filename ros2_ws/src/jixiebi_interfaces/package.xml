<?xml version="1.0"?>
<package format="3">
  <name>jixiebi_interfaces</name>
  <version>0.1.0</version>
  <description>Typed raw servo query samples; protocol P values are not joint angles</description>
  <maintainer email="maintainer@example.invalid">Jixiebi maintainers</maintainer>
  <license>MIT</license>

  <!-- 构建消息定义，向其他包提供生成的C++/Python类型。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>builtin_interfaces</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
